API_PORT=3000
API_ENV=dev

# (Genera un secreto aleatorio siguiendo las instrucciones del README.)
JWT_SECRET=

CRYPTO_CACHE_MINUTES=15

# Conexión a base de datos
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=user
MYSQL_PASSWORD=password
MYSQL_DATABASE=database

# CORS
CORS_ORIGIN=http://localhost:8080,https://miapp.com,https://admin.miapp.com

# Controles de seguridad en autenticación (opcionales) si se omiten se usan los valores por defecto
TRUST_PROXY=
# Duración de la ventana durante la que se cuentan solicitudes y fallos (900 = 15 min).
AUTH_WINDOW_SECONDS=900
# Máximo de fallos por usuario para cada operación
AUTH_ACCOUNT_MAX_FAILURES=5
# Máximo de solicitudes por IP, compartido entre todas las rutas de /api/auth
AUTH_IP_MAX_REQUESTS=100
# Limita cuántos contadores puede guardar el backend en memoria. Su propósito es evitar que esa memoria crezca sin límite.
# Cada contador caduca según AUTH_WINDOW_SECONDS
AUTH_MAX_ENTRIES=10000
